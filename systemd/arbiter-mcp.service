[Unit]
Description=[arbiter-mcp] MCP facade for the arbiter sidecar (streamable-http :8020/mcp)
Documentation=https://github.com/Fr3akaz0id/arbiter
After=network-online.target arbiter.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/arbiter-mcp
Environment=ARBITER_URL=http://127.0.0.1:8010
ExecStart=/opt/arbiter-mcp/.venv/bin/python /opt/arbiter-mcp/integrations/mcp/arbiter_mcp.py --transport streamable-http --host 0.0.0.0 --port 8020 --path /mcp
Restart=on-failure
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=30
UMask=0022
KillSignal=SIGTERM
OOMScoreAdjust=-200
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arbiter-mcp

[Install]
WantedBy=multi-user.target
